# =============================================================================
# My Toolbox - Environment Variables
# Copy this file to `.env` and fill in real values.
# Never commit `.env` to git.
# =============================================================================

# --- Flask core ---
FLASK_ENV=production
SECRET_KEY=please-change-me-to-a-long-random-string-at-least-32-chars
SESSION_COOKIE_DOMAIN=
# Production must set true (HTTPS). Keep false for local HTTP debugging.
SESSION_COOKIE_SECURE=false
# APP_BASE_URL is used in emails / OG tags. Include scheme + host, no trailing slash.
APP_BASE_URL=https://toolbox.example.com

# --- Database ---
# Default: SQLite inside instance/. Swap to PostgreSQL URI for scale-up.
DATABASE_URL=sqlite:///app.db

# --- Bootstrap admin (created on first run) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# --- Limits & behavior ---
DAILY_FREE_LIMIT=10
ANON_FREE_LIMIT=3
MAX_UPLOAD_MB=25
MAX_PDF_FILES=10
MAX_PDF_PAGES=200
TEMP_FILE_TTL_MINUTES=30

# --- Rate limit (Flask-Limiter) ---
RATELIMIT_DEFAULT=120/minute
RATELIMIT_TOOL=20/minute

# --- Server binding (used by gunicorn / local dev) ---
HOST=127.0.0.1
PORT=8000

# --- Timezone (display only; DB stores UTC) ---
DISPLAY_TIMEZONE=Asia/Shanghai

# --- 百度智能云 OCR (增值税发票识别) ---
# 注册地址: https://console.bce.baidu.com/ai/#/ai/ocr/overview/index
# 免费额度: 每月 1000 次
BAIDU_OCR_API_KEY=your-baidu-api-key
BAIDU_OCR_SECRET_KEY=your-baidu-secret-key

# --- 腾讯云 OCR（增值税发票识别；国内推荐，可复用已有腾讯云密钥） ---
# 建议单独建子账号并授予 ocr:VatInvoiceOCR 权限；留空则回退使用 COS_SECRET_ID/KEY
OCR_SECRET_ID=your-tencent-ocr-secret-id
OCR_SECRET_KEY=your-tencent-ocr-secret-key


# Shared only between Flask and the Next.js server; at least 32 UTF-8 bytes.
# Never commit the real value and never expose it to browsers.
GALLERY_INTROSPECTION_SECRET=please-change-me-to-a-long-random-secret

# Public Gallery Web URL. Use a Vercel branch alias in staging/Preview and the
# approved production domain only after release approval.
AI_IMAGE_EXTERNAL_URL=

# --- Gallery admin bridge (Flask admin -> Generation Service) ---
# Public HTTPS API origin of the Generation Service. Use the same value as the
# Vercel-side GALLERY_SERVICE_BASE_URL.
GALLERY_SERVICE_BASE_URL=
# Shared HMAC secret (>= 32 UTF-8 bytes) with the Generation Service. Use the
# same value as the Vercel-side GALLERY_INTERNAL_HMAC_SECRET.
GALLERY_INTERNAL_HMAC_SECRET=

# --- Database operation budget ---
# Refresh database-backed site settings at most once per interval (seconds)
# instead of on every request.
RUNTIME_SETTINGS_TTL_SECONDS=30
# Set false when the schema is migration-managed (production) to skip the
# cold-start schema probe and create_all() reflection.
AUTO_CREATE_SCHEMA=true
