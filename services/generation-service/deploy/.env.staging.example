# Copy to deploy/.env.staging on the server. Never commit the populated file.
APP_ENV=staging
GENERATION_API_DOMAIN=api-ai-staging.example.com

# Use URL-safe random strings so they can be embedded in internal connection URLs.
POSTGRES_DB=generation_staging
POSTGRES_USER=generation
POSTGRES_PASSWORD=replace_with_url_safe_random_value
REDIS_PASSWORD=replace_with_url_safe_random_value

# Three different secrets, each at least 32 random bytes.
GALLERY_CURSOR_SECRET=replace_with_independent_random_value
GALLERY_INTERNAL_HMAC_SECRET=replace_with_independent_random_value
GALLERY_ASSET_HOSTS=examplebucket.cos.ap-guangzhou.myqcloud.com

# Tencent COS staging bucket or an isolated staging prefix with least privilege.
COS_SECRET_ID=
COS_SECRET_KEY=
COS_SECURITY_TOKEN=
COS_BUCKET=
COS_REGION=
COS_CDN_BASE_URL=

# Queue settings: conservative defaults for a 4 CPU / 4 GB staging server.
BULLMQ_PREFIX=mavis-staging
BULLMQ_QUEUE_NAME=generation
BULLMQ_CANCEL_CHANNEL=generation-cancel
BULLMQ_CONCURRENCY=1
BULLMQ_ATTEMPTS=3
BULLMQ_BACKOFF_MS=1000
BULLMQ_COMPLETED_RETENTION_COUNT=200
BULLMQ_FAILED_RETENTION_COUNT=500
BULLMQ_RETENTION_AGE_SECONDS=604800
BULLMQ_MAX_STALLED_COUNT=1
BULLMQ_LOCK_DURATION_MS=120000
BULLMQ_GRACEFUL_SHUTDOWN_MS=30000
GENERATION_OUTBOX_BATCH_SIZE=20
GENERATION_OUTBOX_RETRY_BASE_MS=1000
GENERATION_OUTBOX_RETRY_MAX_MS=60000
GENERATION_OUTBOX_POLL_MS=1000
# 空闲时指数退避的上限（队列无消息时降低数据库操作量）
GENERATION_OUTBOX_IDLE_MAX_MS=30000

GENERATION_DEFAULT_CREDIT_COST=1
GENERATION_TEMP_DIR=/tmp/generation
GENERATION_POLL_INTERVAL_MS=500
GENERATION_POLL_MAX_ATTEMPTS=120
GENERATION_REMOTE_DOWNLOAD_TIMEOUT_MS=60000
GENERATION_PROVIDER_RETRY_BASE_MS=500
GENERATION_PROVIDER_MAX_TOTAL_CALLS=3
GENERATION_LOG_PROMPTS=false
# pending = admin approval before public gallery; approved = immediate publish (staging convenience only)
GALLERY_DEFAULT_MODERATION=pending

# Mock is staging-only. Disable it when a real provider is enabled.
GENERATION_ALLOW_MOCK_PROVIDER=true
GENERATION_MOCK_LATENCY_MS=1200

# Optional remote providers. Leave all keys empty to keep them disabled.
OPENAI_API_KEY=
OPENAI_BASE_URL=
GEMINI_API_KEY=
GEMINI_BASE_URL=
JIMENG_API_KEY=
JIMENG_BASE_URL=
REMOTE_PROVIDER_REQUEST_TIMEOUT_MS=60000
REMOTE_PROVIDER_MAX_RESPONSE_BYTES=20971520

# Billing remains disabled in M1 staging.
BILLING_STRIPE_ENABLED=false
BILLING_PUBLIC_BASE_URL=https://ai-staging.example.com
# One-time credits granted when a new user first opens the account summary.
BILLING_SIGNUP_GRANT=10
