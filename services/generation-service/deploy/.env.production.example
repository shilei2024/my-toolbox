# Copy manually to /etc/mindfulpenpal.production.env on the server.
# Never commit or paste the populated file into chat, tickets, or logs.
APP_ENV=production
PRODUCTION_RELEASE_APPROVED=false
GENERATION_ENV_FILE=/etc/mindfulpenpal.production.env

# Pin all runtime images by immutable digest. Replace every placeholder.
GENERATION_IMAGE=registry.example.invalid/mindfulpenpal/generation-service@sha256:replace_with_64_hex_characters
POSTGRES_MIGRATION_IMAGE=postgres:16-alpine@sha256:replace_with_64_hex_characters
CADDY_IMAGE=caddy:2.10-alpine@sha256:replace_with_64_hex_characters
GENERATION_API_DOMAIN=api-ai.example.com

# Dedicated production managed services. Redis must use TLS.
DATABASE_URL=postgresql://replace_with_production_connection_url
REDIS_URL=rediss://replace_with_production_connection_url

# Independent random values, each at least 32 random bytes.
GALLERY_CURSOR_SECRET=replace_with_independent_random_value
GALLERY_INTERNAL_HMAC_SECRET=replace_with_independent_random_value
GALLERY_ASSET_HOSTS=replace_with_cos_or_cdn_hostname
GALLERY_CACHE_TTL_SECONDS=30
GALLERY_DELETION_RETENTION_SECONDS=86400
GALLERY_PRIVATE_URL_TTL_SECONDS=300
GALLERY_DELETION_POLL_MS=30000
GALLERY_DELETION_BATCH_SIZE=20
GALLERY_DELETION_RETRY_BASE_SECONDS=60

# Dedicated production COS bucket or production-only prefix and least-privilege CAM user.
COS_SECRET_ID=
COS_SECRET_KEY=
COS_SECURITY_TOKEN=
COS_BUCKET=
COS_REGION=
COS_CDN_BASE_URL=

# Conservative settings for a 4 CPU / 4 GB application host.
BULLMQ_PREFIX=mavis-production
BULLMQ_QUEUE_NAME=generation
BULLMQ_CANCEL_CHANNEL=generation-cancel
BULLMQ_CONCURRENCY=1
BULLMQ_ATTEMPTS=3
BULLMQ_BACKOFF_MS=1000
BULLMQ_COMPLETED_RETENTION_COUNT=1000
BULLMQ_FAILED_RETENTION_COUNT=2000
BULLMQ_RETENTION_AGE_SECONDS=2592000
BULLMQ_MAX_STALLED_COUNT=1
BULLMQ_LOCK_DURATION_MS=120000
BULLMQ_GRACEFUL_SHUTDOWN_MS=30000
GENERATION_OUTBOX_BATCH_SIZE=20
GENERATION_OUTBOX_RETRY_BASE_MS=1000
GENERATION_OUTBOX_RETRY_MAX_MS=60000
GENERATION_OUTBOX_POLL_MS=1000

GENERATION_DEFAULT_CREDIT_COST=1
GENERATION_TEMP_DIR=/tmp/generation
GENERATION_POLL_INTERVAL_MS=500
GENERATION_POLL_MAX_ATTEMPTS=120
GENERATION_REMOTE_DOWNLOAD_TIMEOUT_MS=60000
GENERATION_PROVIDER_RETRY_BASE_MS=500
GENERATION_PROVIDER_MAX_TOTAL_CALLS=3
GENERATION_LOG_PROMPTS=false
GENERATION_ALLOW_MOCK_PROVIDER=false
# pending = every image requires admin approval before public gallery/SEO;
# approved = images are published immediately (use only with a trusted moderation policy)
GALLERY_DEFAULT_MODERATION=pending

# Configure at least one real provider. Leave unused providers empty.
OPENAI_API_KEY=
OPENAI_BASE_URL=
GEMINI_API_KEY=
GEMINI_BASE_URL=
JIMENG_API_KEY=
JIMENG_BASE_URL=
REMOTE_PROVIDER_REQUEST_TIMEOUT_MS=60000
REMOTE_PROVIDER_MAX_RESPONSE_BYTES=20971520

# Optional private ComfyUI. Do not expose ComfyUI directly to the public Internet.
COMFYUI_BASE_URL=
COMFYUI_AUTH_TOKEN=
COMFYUI_HEADERS_JSON={}
COMFYUI_REQUEST_TIMEOUT_MS=30000
COMFYUI_DOWNLOAD_TIMEOUT_MS=60000
COMFYUI_RETRY_COUNT=2
COMFYUI_RETRY_DELAY_MS=1000
COMFYUI_POLL_INTERVAL_MS=1000
COMFYUI_POLL_MAX_ATTEMPTS=600
COMFYUI_ALLOW_GLOBAL_INTERRUPT=false
COMFYUI_WORKFLOW_DIR=/app/src/workflows
COMFYUI_DOWNLOAD_DIR=/tmp/generation
COMFYUI_DEFAULT_MODEL=
COMFYUI_DEFAULT_STEPS=28
COMFYUI_DEFAULT_CFG=7
COMFYUI_DEFAULT_SAMPLER=euler
COMFYUI_DEFAULT_SCHEDULER=normal

# M1 production keeps Stripe disabled; mainland-China payment adapters remain separate.
BILLING_STRIPE_ENABLED=false
BILLING_PUBLIC_BASE_URL=https://example.invalid
# One-time credits granted when a new user first opens the account summary.
# Set to 0 to disable free credits entirely.
BILLING_SIGNUP_GRANT=10
