{
  "1": { "class_type": "UNETLoader", "inputs": { "unet_name": "{{model}}", "weight_dtype": "default" } },
  "2": { "class_type": "ReservedVRAMSetter", "inputs": { "reserved": 1.0, "mode": "manual", "seed": "{{seed}}", "auto_max_reserved": 0.0, "clean_gpu_before": true, "anything": ["1", 0] } },
  "3": { "class_type": "MiniMaxH3MemoryEfficientSageAttentionPatch", "inputs": { "model": ["2", 0] } },
  "4": { "class_type": "LoraLoaderModelOnly", "inputs": { "model": ["3", 0], "lora_name": "minimax_h3_turbo_4STEPS_comfyui.safetensors", "strength_model": 1.0 } },
  "5": { "class_type": "CLIPLoader", "inputs": { "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors", "type": "minimax", "device": "default" } },
  "6": { "class_type": "VAELoader", "inputs": { "vae_name": "minimax_h3_video_vae_fp16.safetensors" } },
  "7": { "class_type": "VAELoader", "inputs": { "vae_name": "minimax_h3_audio_vae_fp32.safetensors" } },
  "8": { "class_type": "PrimitiveStringMultiline", "inputs": { "value": "{{prompt}}" } },
  "9": { "class_type": "PrimitiveFloat", "inputs": { "value": "{{duration_seconds}}" } },
  "10": { "class_type": "ComfyMathExpression", "inputs": { "expression": "max(5, round(a * 24)) + (5 - (max(5, round(a * 24)) % 17)) % 17", "values.a": ["9", 0] } },
  "11": { "class_type": "LoadImage", "inputs": { "image": "{{ref_image_0}}" } },
  "12": {
    "class_type": "MiniMaxH3AudioConditioningT8",
    "inputs": {
      "clip": ["5", 0],
      "video_vae": ["6", 0],
      "audio_vae": ["7", 0],
      "prompt": ["8", 0],
      "width": "{{width}}",
      "height": "{{height}}",
      "length": ["10", 1],
      "task_type": "Ref2VA",
      "audio_mode": "native",
      "audio_denoise_strength": 1.0,
      "add_source_as_reference": false,
      "prompt_primary_audio_ordinal": 0,
      "strict_prompt_tags": true,
      "ref_image_size": "max",
      "reference_video_policy": "official_2_to_15s",
      "ref_images.ref_image_0": ["11", 0]
    }
  },
  "13": { "class_type": "MiniMaxH3MultiRateSamplerEXPT8", "inputs": { "model": ["4", 0], "av_latent": ["12", 1], "video_steps": 8, "audio_steps": 10, "shift_video": 12.0, "shift_audio": 3.0 } },
  "14": { "class_type": "BasicGuider", "inputs": { "model": ["13", 0], "conditioning": ["12", 0], "cfg": 1.0 } },
  "15": { "class_type": "RandomNoise", "inputs": { "noise_seed": "{{seed}}" } },
  "16": { "class_type": "SamplerCustomAdvanced", "inputs": { "noise": ["15", 0], "guider": ["14", 0], "sampler": ["13", 1], "sigmas": ["13", 2], "latent_image": ["12", 1] } },
  "17": { "class_type": "MiniMaxH3AVDecodeT8", "inputs": { "av_latent": ["16", 0], "video_vae": ["6", 0], "audio_vae": ["7", 0] } },
  "18": { "class_type": "VHS_VideoCombine", "inputs": { "images": ["17", 0], "audio": ["17", 1], "frame_rate": 24, "loop_count": 0, "filename_prefix": "MiniMaxH3/i2v", "format": "video/h264-mp4", "pix_fmt": "yuv420p", "crf": 19, "save_metadata": true, "trim_to_audio": false, "pingpong": false, "save_output": true } }
}
