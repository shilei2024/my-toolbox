# Generation Service environment (Node.js).
# Copy to `.env` in this directory (never commit). The npm run scripts load
# this file automatically with `--env-file-if-exists=.env`.
#
# Required by the Gallery API (gallery:start):
DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/my_toolbox
COS_SECRET_ID=
COS_SECRET_KEY=
COS_SECURITY_TOKEN=
COS_BUCKET=
COS_REGION=
COS_CDN_BASE_URL=
GALLERY_ASSET_HOSTS=127.0.0.1,localhost
GALLERY_CURSOR_SECRET=please-change-me-to-a-long-random-secret
GALLERY_INTERNAL_HMAC_SECRET=please-change-me-to-a-long-random-secret

# Redis + queue (required by dispatcher/worker; enables generation creation).
REDIS_URL=redis://127.0.0.1:6379/0
BULLMQ_PREFIX=bull
BULLMQ_QUEUE_NAME=generation
BULLMQ_CANCEL_CHANNEL=generation:cancel
BULLMQ_CONCURRENCY=2
BULLMQ_ATTEMPTS=3
BULLMQ_BACKOFF_MS=1000
BULLMQ_COMPLETED_RETENTION_COUNT=1000
BULLMQ_FAILED_RETENTION_COUNT=2000
BULLMQ_RETENTION_AGE_SECONDS=1209600
BULLMQ_MAX_STALLED_COUNT=2
BULLMQ_LOCK_DURATION_MS=120000
BULLMQ_GRACEFUL_SHUTDOWN_MS=15000
GENERATION_OUTBOX_BATCH_SIZE=20
GENERATION_OUTBOX_RETRY_BASE_MS=500
GENERATION_OUTBOX_RETRY_MAX_MS=30000
GENERATION_OUTBOX_POLL_MS=1000

# Local preview: use the mock provider and auto-publish images for review.
APP_ENV=development
GENERATION_ALLOW_MOCK_PROVIDER=true
GENERATION_MOCK_LATENCY_MS=1200
GALLERY_DEFAULT_MODERATION=approved

# Generation runtime defaults (tune as needed).
GENERATION_DEFAULT_CREDIT_COST=1
GENERATION_TEMP_DIR=../../.tmp/generation
GENERATION_POLL_INTERVAL_MS=1000
GENERATION_POLL_MAX_ATTEMPTS=600
GENERATION_REMOTE_DOWNLOAD_TIMEOUT_MS=60000
GENERATION_PROVIDER_RETRY_BASE_MS=500
GENERATION_PROVIDER_MAX_TOTAL_CALLS=6

# Optional real providers (leave empty to keep them disabled):
OPENAI_API_KEY=
OPENAI_BASE_URL=
GEMINI_API_KEY=
GEMINI_BASE_URL=
JIMENG_API_KEY=
JIMENG_BASE_URL=
COMFYUI_BASE_URL=
COMFYUI_AUTH_TOKEN=
COMFYUI_DEFAULT_MODEL=
