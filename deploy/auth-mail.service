[Unit]
Description=My Toolbox authentication email delivery
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/opt/mytoolbox
Environment="PATH=/opt/mytoolbox/.venv/bin"
Environment="FLASK_APP=app:create_app"
EnvironmentFile=/opt/mytoolbox/.env
ExecStartPre=/opt/mytoolbox/.venv/bin/flask auth-mail-check
ExecStart=/opt/mytoolbox/.venv/bin/flask auth-mail-dispatch
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
