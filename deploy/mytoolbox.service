[Unit]
Description=My Toolbox (Flask)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/mytoolbox
Environment="PATH=/opt/mytoolbox/.venv/bin"
EnvironmentFile=/opt/mytoolbox/.env
# Bind 0.0.0.0 so Docker containers (Caddy/cloudflared) can reach the main site
# via host.docker.internal:8000. Port 8000 is not exposed publicly: the Tencent
# security group only opens 22/80/443 and ufw only allows 8000 from 172.16.0.0/12.
ExecStart=/opt/mytoolbox/.venv/bin/gunicorn \
    -w 2 -k gthread --threads 4 -b 0.0.0.0:8000 \
    --access-logfile - --error-logfile - \
    --timeout 120 \
    app:app
Restart=always
RestartSec=3
LimitNOFILE=65535
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
