# MindfulPenpal AI 增强版 - 生产环境变量模板（非程序员部署用）
#
# 用法：
#   1) 复制为 /etc/mindfulpenpal.production.env（服务器上）
#   2) 逐项把 replace_... 占位符替换为真实值
#   3) 权限必须为 600：sudo chmod 600 /etc/mindfulpenpal.production.env
#   4) 不要把填好的文件提交到 Git、发到聊天或工单

# ===== 运行环境与镜像（腾讯云服务器） =====
APP_ENV=production
PRODUCTION_RELEASE_APPROVED=false
GENERATION_ENV_FILE=/etc/mindfulpenpal.production.env

# 生产镜像必须锁定不可变 digest（禁止 latest/tag）
# 生产镜像必须锁定为不可变 digest（禁止 latest/tag）。
# 只有在本机构建镜像的小型单机部署中，才可显式设置
# ALLOW_LOCAL_IMAGE_TAGS=true 并使用 name:tag（例如 :0.4.0）。
ALLOW_LOCAL_IMAGE_TAGS=false
GENERATION_IMAGE=registry.example.invalid/mindfulpenpal/generation-service@sha256:replace_with_64_hex_characters
POSTGRES_MIGRATION_IMAGE=postgres:16-alpine@sha256:replace_with_64_hex_characters
CADDY_IMAGE=caddy:2.10-alpine@sha256:replace_with_64_hex_characters

# Generation API 的公网域名（Caddy 自动申请 HTTPS 证书）
GENERATION_API_DOMAIN=api-ai.example.com

# ===== Gallery Web（部署在 Vercel，不在本服务器运行） =====
# Gallery Web 是独立 Vercel 项目（Root Directory: apps/gallery-web），其环境变量
# 配置在 Vercel Dashboard：GALLERY_SERVICE_BASE_URL / GALLERY_INTERNAL_HMAC_SECRET /
# MAVIS_AUTH_INTROSPECTION_URL / GALLERY_INTROSPECTION_SECRET / GALLERY_PUBLIC_ORIGIN /
# MAVIS_AUTH_LOGIN_URL / MAVIS_AUTH_LOGOUT_URL。本服务器不需要这些变量。

# ===== 数据库与 Redis =====
# 生产推荐托管 PostgreSQL / Redis（Redis 必须 TLS：rediss://）。
# 只有小型自托管/验收才使用 local-infra profile，并把 DATABASE_URL 改为
# postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>，
# REDIS_URL 改为 redis://redis:6379。
# 生产推荐托管 PostgreSQL / Redis，Redis 必须 TLS（rediss://）。
# 小型单机部署可用 compose 的 local-infra Redis（仅 Docker 内网）：
#   REDIS_URL=redis://redis:6379
#   并把 ALLOW_PLAINTEXT_REDIS 改为 true（Redis 不发布公网端口）。
ALLOW_PLAINTEXT_REDIS=false
# 若使用服务器本机安装的 PostgreSQL（已有服务器场景），容器内填：
#   postgresql://<用户>:<密码>@host.docker.internal:5432/<数据库>?uselibpqcompat=true&sslmode=require
DATABASE_URL=postgresql://replace_with_production_connection_url?sslmode=require
# Cross-public-internet connection pool tuning (milliseconds)
DATABASE_CONNECTION_TIMEOUT_MS=15000
DATABASE_IDLE_TIMEOUT_MS=30000
REDIS_URL=rediss://replace_with_production_connection_url

# 仅 local-infra profile 使用（托管模式留空即可）
POSTGRES_USER=mavis
POSTGRES_PASSWORD=
POSTGRES_DB=mindfulpenpal

# ===== 随机密钥（每个都独立，至少 32 字节） =====
GALLERY_CURSOR_SECRET=replace_with_independent_random_value
GALLERY_INTERNAL_HMAC_SECRET=replace_with_independent_random_value
GALLERY_ASSET_HOSTS=replace_with_cos_or_cdn_hostname
GALLERY_CACHE_TTL_SECONDS=30
GALLERY_DELETION_RETENTION_SECONDS=86400
GALLERY_PRIVATE_URL_TTL_SECONDS=300
GALLERY_DELETION_POLL_MS=30000
GALLERY_DELETION_BATCH_SIZE=20
GALLERY_DELETION_RETRY_BASE_SECONDS=60

# ===== 腾讯云 COS（图片持久化） =====
COS_SECRET_ID=
COS_SECRET_KEY=
COS_SECURITY_TOKEN=
COS_BUCKET=
COS_REGION=
COS_CDN_BASE_URL=

# ===== 队列（保守参数，4 CPU / 4 GB 主机） =====
BULLMQ_PREFIX=mavis-production
BULLMQ_QUEUE_NAME=generation
BULLMQ_CANCEL_CHANNEL=generation-cancel
BULLMQ_CONCURRENCY=1
BULLMQ_ATTEMPTS=3
BULLMQ_BACKOFF_MS=1000
BULLMQ_COMPLETED_RETENTION_COUNT=1000
BULLMQ_FAILED_RETENTION_COUNT=2000
BULLMQ_RETENTION_AGE_SECONDS=2592000
BULLMQ_MAX_STALLED_COUNT=1
BULLMQ_LOCK_DURATION_MS=120000
BULLMQ_GRACEFUL_SHUTDOWN_MS=30000
GENERATION_OUTBOX_BATCH_SIZE=20
GENERATION_OUTBOX_RETRY_BASE_MS=1000
GENERATION_OUTBOX_RETRY_MAX_MS=60000
GENERATION_OUTBOX_POLL_MS=1000
# 空闲时指数退避的上限（队列无消息时降低数据库操作量）
GENERATION_OUTBOX_IDLE_MAX_MS=30000

# ===== 生成任务 =====
GENERATION_DEFAULT_CREDIT_COST=1
GENERATION_TEMP_DIR=/tmp/generation
GENERATION_POLL_INTERVAL_MS=500
GENERATION_POLL_MAX_ATTEMPTS=120
GENERATION_REMOTE_DOWNLOAD_TIMEOUT_MS=60000
GENERATION_PROVIDER_RETRY_BASE_MS=500
GENERATION_PROVIDER_MAX_TOTAL_CALLS=3
GENERATION_LOG_PROMPTS=false
GENERATION_ALLOW_MOCK_PROVIDER=false

# 新图片默认审核状态：pending=人工审核后公开（生产推荐）；approved=生成即公开（慎用）
GALLERY_DEFAULT_MODERATION=pending

# ===== AI Provider（至少配置一个真实 Provider） =====
# OpenAI 生图
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Google Gemini 生图
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# 即梦 / Seedream（字节跳动火山引擎）
JIMENG_API_KEY=
JIMENG_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
REMOTE_PROVIDER_REQUEST_TIMEOUT_MS=60000
REMOTE_PROVIDER_MAX_RESPONSE_BYTES=20971520

# ===== 可选：私有 ComfyUI（不要直接暴露公网） =====
COMFYUI_BASE_URL=
COMFYUI_AUTH_TOKEN=
COMFYUI_HEADERS_JSON={}
COMFYUI_REQUEST_TIMEOUT_MS=30000
COMFYUI_DOWNLOAD_TIMEOUT_MS=120000
COMFYUI_RETRY_COUNT=2
COMFYUI_RETRY_DELAY_MS=1000
COMFYUI_POLL_INTERVAL_MS=1000
COMFYUI_POLL_MAX_ATTEMPTS=7200
COMFYUI_ALLOW_GLOBAL_INTERRUPT=false
COMFYUI_WORKFLOW_DIR=/app/workflows
COMFYUI_DOWNLOAD_DIR=/tmp/generation
COMFYUI_DEFAULT_MODEL=
COMFYUI_DEFAULT_STEPS=28
COMFYUI_DEFAULT_CFG=7
COMFYUI_DEFAULT_SAMPLER=euler
COMFYUI_DEFAULT_SCHEDULER=normal

# ===== 计费（M1 阶段 Stripe 保持关闭，国内支付后续接入） =====
BILLING_STRIPE_ENABLED=false
BILLING_PUBLIC_BASE_URL=https://example.invalid
# 新用户首次打开账户时赠送的一次性积分；0 表示关闭
BILLING_SIGNUP_GRANT=10

# ===== 原网站（Vercel 上的 Flask）额外配置 =====
# 共享登录：Flask 与 Gallery 必须共享受控父域，例如 .mindfulpenpal.com
SESSION_COOKIE_DOMAIN=
# 首页“AI 作图”卡片指向的 Gallery 地址（填 https://<gallery域名>/create）
AI_IMAGE_EXTERNAL_URL=
# Flask 与 Gallery BFF 共享的内部鉴权密钥（至少 32 字节，两端一致）
GALLERY_INTROSPECTION_SECRET=
