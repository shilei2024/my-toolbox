# Mavis Gallery Web (Next.js) environment.
# Copy to `.env` in this directory (never commit). Local loopback HTTP is
# allowed; production must use HTTPS on every URL below.

# Generation Service API origin (same value as Flask GALLERY_SERVICE_BASE_URL).
GALLERY_SERVICE_BASE_URL=http://127.0.0.1:3101
# Shared HMAC secret with Generation Service, at least 32 UTF-8 bytes.
GALLERY_INTERNAL_HMAC_SECRET=please-change-me-to-a-long-random-secret

# Flask introspection endpoint and the shared secret (>= 32 UTF-8 bytes).
MAVIS_AUTH_INTROSPECTION_URL=http://127.0.0.1:8000/internal/gallery/session
MAVIS_AUTH_SESSION_COOKIE_NAME=mytoolbox_session
GALLERY_INTROSPECTION_SECRET=please-change-me-to-a-different-long-random-secret

# Public origin of this site (used for origin checks and SEO).
GALLERY_PUBLIC_ORIGIN=http://127.0.0.1:3000

# Flask login/logout pages; logout is optional.
MAVIS_AUTH_LOGIN_URL=http://127.0.0.1:8000/login
MAVIS_AUTH_LOGOUT_URL=http://127.0.0.1:8000/logout
