/* Shared visual system. Page files only add page-specific layout. */
page {
  background: #F4F1ED;
  color: #302B33;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}
view, button, input, textarea { box-sizing: border-box; }
.page { padding: 24rpx 28rpx 40rpx; padding-bottom: calc(56rpx + env(safe-area-inset-bottom)); }
.hero { display: flex; align-items: center; justify-content: space-between; margin: 12rpx 0 28rpx; gap: 24rpx; }
.hero-copy { flex: 1; min-width: 0; }
.logo { width: 72rpx; height: 72rpx; border-radius: 26rpx; flex-shrink: 0; }
.eyebrow { color: #716975; font-size: 22rpx; font-weight: 600; letter-spacing: 3rpx; margin-bottom: 8rpx; }
.title { font-size: 40rpx; line-height: 1.25; font-weight: 700; letter-spacing: -1rpx; }
.subtitle { font-size: 26rpx; line-height: 1.6; color: #716975; margin-top: 12rpx; }
.card { background: #fff; border: 1rpx solid #E6E0DC; border-radius: 20rpx; padding: 28rpx; margin-bottom: 20rpx; box-shadow: 0 6rpx 20rpx rgba(53, 44, 62, .035); }
.section-head { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-bottom: 24rpx; }
.section-title { font-size: 30rpx; font-weight: 600; line-height: 1.4; margin-bottom: 20rpx; }
.section-head .section-title { margin: 0; }
.section-number { color: #716975; font-size: 22rpx; font-weight: 500; margin-right: 12rpx; }
.muted { color: #716975; font-size: 26rpx; line-height: 1.65; }
.small, .hint { font-size: 24rpx; }
.hint { color: #716975; line-height: 1.7; margin-top: 20rpx; }
.field { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; min-height: 92rpx; padding: 20rpx 0; border-bottom: 1rpx solid #E9E3DF; font-size: 28rpx; }
.field-label { flex-shrink: 0; color: #625866; font-size: 26rpx; }
.field-value { min-width: 0; text-align: right; font-size: 28rpx; font-weight: 500; overflow-wrap: anywhere; }
.field-tail { display: flex; align-items: center; justify-content: flex-end; gap: 14rpx; min-width: 0; max-width: 66%; }
.chevron { color: #877E88; font-size: 36rpx; font-weight: 400; flex-shrink: 0; }
.field-note { color: #716975; font-size: 22rpx; font-weight: 400; margin-top: 4rpx; }
.edit-field { margin-bottom: 24rpx; min-width: 0; }
.edit-field:last-child { margin-bottom: 0; }
.input-label { display: block; color: #625866; font-size: 26rpx; margin-bottom: 12rpx; line-height: 1.5; }
.input, .edit-field input, .input-value {
  width: 100%; background: #F6F3F0; border: 1rpx solid #E5DEDA; border-radius: 16rpx;
  font-size: 28rpx; line-height: 1.5; color: #302B33; padding: 20rpx 24rpx; height: 92rpx;
}
.input-value { height: auto; min-height: 92rpx; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.input-placeholder { color: #716975; }
.input:focus { border-color: #897184; }
input[disabled] { color: #716975; background: #E9E3DF; }
.form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 20rpx; }
button { font-size: 28rpx; line-height: 1.5; min-height: 96rpx; padding: 26rpx 24rpx; border-radius: 18rpx; font-weight: 600; margin: 16rpx 0 0; background: #EEE8EC; color: #514054; white-space: normal; }
button::after { border: 0; }
button.primary { color: #fff; background: #514054; box-shadow: 0 6rpx 16rpx rgba(53,44,62,.12); }
button.secondary { background: #EEE8EC; color: #514054; }
button.ghost { background: transparent; color: #716975; box-shadow: none; }
button.danger { color: #a34c43; background: #fbf0ed; }
button[size="mini"], button.compact { min-height: 72rpx; padding: 16rpx 24rpx; font-size: 24rpx; line-height: 1.6; border-radius: 14rpx; }
button[disabled] { background: #E9E3DF; color: #877E88; box-shadow: none; opacity: 1; }
.button-row, .upload-actions { display: flex; gap: 16rpx; }
.button-row button, .upload-actions button { flex: 1; min-width: 0; }
.button-row { margin-top: 8rpx; }
.link, .refresh { color: #514054; }
.refresh { font-size: 24rpx; font-weight: 500; padding: 16rpx 0 16rpx 20rpx; }
.receipt { padding: 24rpx 0; border-top: 1rpx solid #E9E3DF; }
.receipt:first-child { border-top: 0; }
.file-name { font-size: 28rpx; font-weight: 500; line-height: 1.6; overflow-wrap: anywhere; margin-bottom: 8rpx; }
.receipt-meta { color: #716975; font-size: 24rpx; line-height: 1.7; }
.tag { display: inline-block; font-size: 22rpx; font-weight: 500; color: #27694F; background: #EDF4F0; padding: 8rpx 16rpx; border-radius: 10rpx; margin-top: 12rpx; }
.upload-state { color: #716975; font-size: 24rpx; margin: 12rpx 0; }
.upload-state.success { color: #514054; }
.upload-state.failed { color: #a34c43; }
.message { color: #765c2c; background: #fbf3e3; border: 1rpx solid #f1e5cc; padding: 24rpx; border-radius: 18rpx; font-size: 26rpx; line-height: 1.7; margin-bottom: 24rpx; overflow-wrap: anywhere; }
.empty { color: #716975; font-size: 26rpx; line-height: 1.7; text-align: center; padding: 44rpx 12rpx; }
.empty-symbol { color: #C9BEC6; font-size: 56rpx; margin-bottom: 16rpx; }
.footer { color: #716975; font-size: 24rpx; text-align: center; padding: 28rpx 0; }
.note-panel { border-radius: 18rpx; background: #F6F3F0; padding: 24rpx; margin-top: 24rpx; }
.note-panel .hint { margin: 0; }
.status-dot { display: inline-block; width: 10rpx; height: 10rpx; border-radius: 50%; background: #BA9879; margin-right: 10rpx; }
.summary-card { background: #352C3E; color: #fff; border: 0; padding: 36rpx; }
.summary-label { color: #E4DAE3; font-size: 26rpx; }
.summary-value { font-size: 64rpx; font-weight: 600; line-height: 1.2; letter-spacing: -2rpx; margin: 18rpx 0 30rpx; overflow-wrap: anywhere; }
.summary-currency { font-size: 30rpx; color: #E4DAE3; margin-right: 12rpx; }
.summary-bottom { display: flex; gap: 32rpx; border-top: 1rpx solid #66566B; padding-top: 26rpx; }
.summary-stat { flex: 1; min-width: 0; }
.summary-stat-value { font-size: 32rpx; font-weight: 600; margin-top: 8rpx; }
.dashboard-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 20rpx; margin-bottom: 24rpx; }
.dashboard-grid .card { margin: 0; padding: 28rpx; }
.kpi { font-size: 38rpx; font-weight: 600; margin-top: 16rpx; line-height: 1.25; overflow-wrap: anywhere; }
.kpi-unit { color: #716975; font-size: 22rpx; margin-left: 8rpx; font-weight: 400; }
.privacy-mask { position: fixed; inset: 0; z-index: 99; background: rgba(35,29,39,.48); display: flex; align-items: center; justify-content: center; padding: 40rpx; }
.privacy-card { padding: 36rpx; border-radius: 28rpx; background: #fff; width: 100%; max-height: 90vh; overflow-y: auto; }
.privacy-link { font-size: 26rpx; margin: 24rpx 0; }
@media (max-width: 350px) {
  .page { padding-left: 24rpx; padding-right: 24rpx; }
  .card { padding: 28rpx; }
  .title { font-size: 42rpx; }
  .field { gap: 16rpx; }
}

/* Secondary disclosures keep optional instructions out of the main flow. */
button.disclosure { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; width: 100%; min-height: 88rpx; padding: 16rpx 0; margin-top: 8rpx; background: transparent; color: #625866; font-size: 26rpx; font-weight: 400; text-align: left; box-shadow: none; }
.disclosure text { color: #514054; flex-shrink: 0; }
.note-panel { font-size: 26rpx; line-height: 1.65; }

/* Warm stone surfaces with aubergine emphasis and restrained bronze accents. */
.summary-card { background: linear-gradient(125deg, #352C3E 0%, #504052 100%); border: 1rpx solid #625068; box-shadow: 0 12rpx 32rpx rgba(53,44,62,.10); }
.summary-card .status-dot { background: #BA9879; }
.upload-state.success { color: #27694F; }
