<view class="page">
  <view class="hero"><view class="hero-copy"><view class="eyebrow">INVOICE ASSISTANT</view><view class="title">每一笔，心中有数。</view><view class="subtitle">你的报销工作台</view></view><image src="/assets/logo-v1.png" class="logo" mode="aspectFill"/></view>
  <view class="message" wx:if="{{authReady && message}}">{{message}}</view>
  <view wx:if="{{authReady && !loggedIn}}" class="card"><view class="section-title">从连接账号开始</view><view class="muted">让手机里的票据，回到同一个报销工作台。</view><button class="primary" bindtap="goMine">连接网站账号</button></view>
  <block wx:if="{{authReady && loggedIn}}">
<view class="card"><picker range="{{periods}}" range-key="name" value="{{periodIndex}}" bindchange="period" disabled="{{busy}}"><view class="period-select"><view><view class="input-label">当前报销周期</view><view class="period-name">{{periods[periodIndex].name || '还没有周期，先新建一个'}}</view></view><text class="chevron">›</text></view></picker><view class="period-actions"><text class="link" bindtap="toggleCreate">{{creating ? '取消新建' : '＋ 新建报销周期'}}</text></view><view wx:if="{{creating}}" class="create-panel"><view class="input-label">起始月份（自动覆盖连续两个月）</view><picker mode="date" fields="month" value="{{newMonth}}" bindchange="onNewMonth" disabled="{{busy}}"><view class="field"><text class="field-label">起始月</text><view class="field-tail"><text class="field-value">{{newMonth || '请选择'}}</text><text class="chevron">›</text></view></view></picker><button class="primary" bindtap="createPeriod" loading="{{busy}}" disabled="{{busy}}">创建并切换</button><view class="hint">周期按两个月一段；创建后自动设为当前周期，可随时切换。</view></view></view>
    <block wx:if="{{summary}}">
      <view class="card summary-card"><view class="summary-label"><text class="status-dot"></text>本期费用</view><view class="summary-value"><text class="summary-currency">¥</text>{{summary.total_amount}}</view><view class="summary-bottom"><view class="summary-stat"><view class="summary-label">已收票据</view><view class="summary-stat-value">{{summary.invoice_count}} <text class="summary-label">张</text></view></view><view class="summary-stat"><view class="summary-label">待核对</view><view class="summary-stat-value">{{summary.pending_count}} <text class="summary-label">张</text></view></view></view></view>
      <view class="section-head"><view class="section-title">出行概览</view><text class="refresh" bindtap="refresh">刷新</text></view>
      <view class="dashboard-grid"><view class="card distance-card"><view class="muted">实际行驶</view><view class="kpi">{{summary.km_total}}<text class="kpi-unit">km</text></view></view><view class="card"><view class="muted">过桥费</view><view class="kpi">{{summary.toll_fee}}<text class="kpi-unit">元</text></view></view><view class="card"><view class="muted">停车费</view><view class="kpi">{{summary.parking_fee}}<text class="kpi-unit">元</text></view></view></view>
    </block>
    <view class="card"><view class="section-title">开始一笔新记录</view><view class="muted">收好原件，核对信息，再确认录入。</view><button class="primary" bindtap="goInvoices">录入发票</button><button class="secondary" bindtap="goDispatch">填写派车单</button></view>
    <button class="ghost" bindtap="refresh" loading="{{busy}}" disabled="{{busy}}">刷新工作台</button>
  </block>
</view>
