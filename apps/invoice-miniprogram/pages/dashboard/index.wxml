<view class="page"><view class="hero"><image src="/assets/logo-v1.png" class="logo"/><view><view class="title">报销工作台</view><view class="subtitle">当期进度，随手掌握。</view></view></view>
<view class="message" wx:if="{{message}}">{{message}}</view>
<button wx:if="{{!loggedIn}}" class="primary" bindtap="goMine">去我的登录</button>
<block wx:if="{{loggedIn}}"><view class="card"><view class="section-title">当前报销周期</view><picker range="{{periods}}" range-key="name" value="{{periodIndex}}" bindchange="period" disabled="{{busy}}"><view class="field">{{periods[periodIndex].name || '请先创建周期'}} ›</view></picker><view class="hint">发票与派车单共用此周期；实际发生月仍单独记录。</view></view>
<view wx:if="{{summary}}" class="dashboard-grid"><view class="card"><view class="muted">本期费用（元）</view><view class="kpi">{{summary.total_amount}}</view></view><view class="card"><view class="muted">票据张数（含留存）</view><view class="kpi">{{summary.invoice_count}}</view></view><view class="card"><view class="muted">待核对票据</view><view class="kpi">{{summary.pending_count}}</view></view><view class="card"><view class="muted">实际行驶公里</view><view class="kpi">{{summary.km_total}}</view></view><view class="card"><view class="muted">过桥费（元）</view><view class="kpi">{{summary.toll_fee}}</view></view><view class="card"><view class="muted">停车费（元）</view><view class="kpi">{{summary.parking_fee}}</view></view></view>
<button class="primary" bindtap="goInvoices">录入发票</button><button class="secondary" bindtap="goDispatch">填写派车单</button><button class="secondary" bindtap="refresh" loading="{{busy}}">刷新仪表盘</button></block></view>
