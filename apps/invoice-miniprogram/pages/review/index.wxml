<view class="page">
 <view class="hero"><view class="hero-copy"><view class="eyebrow">REVIEW & CONFIRM</view><view class="title">核对这张票据</view><view class="subtitle">信息准确，报销才安心。</view></view></view>
 <view class="message" wx:if="{{message}}">{{message}}</view>
 <block wx:if="{{invoice}}">
 <view class="card original-card"><view class="section-head"><view class="section-title">票据原件</view><text class="tag">{{invoice.status_label}}</text></view><view class="file-name">{{invoice.file_name}}</view><view class="button-row"><button class="secondary compact" bindtap="original">查看原件</button><button class="secondary compact" bindtap="retryRecognize" loading="{{busy}}" disabled="{{busy}}">重新识别</button></view></view>
 <view class="card"><view class="section-title"><text class="section-number">01</text>票面信息</view>
 <view wx:for="{{textFields}}" wx:key="key" class="edit-field"><text class="input-label">{{item.name}}</text><input value="{{invoice[item.key]}}" data-key="{{item.key}}" bindinput="input" disabled="{{busy}}" maxlength="{{item.key==='remarks'?4000:item.key==='description'?500:item.key==='vendor'?255:64}}" placeholder="请填写{{item.name}}" placeholder-class="input-placeholder"/></view>
 <view class="edit-field"><text class="input-label">开票日期</text><picker mode="date" value="{{invoice.invoice_date}}" data-key="invoice_date" bindchange="input" disabled="{{busy}}"><view class="input-value"><text>{{invoice.invoice_date || '请选择日期'}}</text><text class="chevron">›</text></view></picker></view>
 </view>
 <view class="card"><view class="section-title"><text class="section-number">02</text>票面金额</view><view wx:for="{{moneyFields}}" wx:key="key" class="edit-field"><text class="input-label">{{item.name}} · 元</text><input type="digit" value="{{invoice[item.key]}}" data-key="{{item.key}}" bindinput="input" disabled="{{busy}}" placeholder="0.00" placeholder-class="input-placeholder"/></view><view class="field"><text class="field-label">已核对票面金额</text><switch color="#176b50" checked="{{invoice.amount_confirmed}}" data-key="amount_confirmed" bindchange="toggle" disabled="{{busy}}"/></view></view>
 <view class="card"><view class="section-title"><text class="section-number">03</text>报销归属</view>
<picker range="{{periods}}" range-key="name" value="{{period_idIndex}}" data-key="period_id" data-list="periods" bindchange="pick" disabled="{{busy}}"><view class="field"><text class="field-label">归属周期</text><view class="field-tail"><text class="field-value">{{periods[period_idIndex].name}}</text><text class="chevron">›</text></view></view></picker>
<picker range="{{offices}}" range-key="name" value="{{office_idIndex}}" data-key="office_id" data-list="offices" bindchange="pick" disabled="{{busy}}"><view class="field"><text class="field-label">办事处</text><view class="field-tail"><text class="field-value">{{offices[office_idIndex].name}}</text><text class="chevron">›</text></view></view></picker>
<picker range="{{categories}}" range-key="name" value="{{category_idIndex}}" data-key="category_id" data-list="categories" bindchange="pick" disabled="{{busy}}"><view class="field"><text class="field-label">费用类别</text><view class="field-tail"><text class="field-value">{{categories[category_idIndex].name}}</text><text class="chevron">›</text></view></view></picker>
<picker range="{{product_lines}}" range-key="name" value="{{product_line_idIndex}}" data-key="product_line_id" data-list="product_lines" bindchange="pick" disabled="{{busy}}"><view class="field"><text class="field-label">产品线</text><view class="field-tail"><text class="field-value">{{product_lines[product_line_idIndex].name}}</text><text class="chevron">›</text></view></view></picker>
<picker range="{{kinds}}" range-key="name" value="{{kindIndex}}" data-key="document_kind" data-list="kinds" bindchange="pick" disabled="{{busy}}"><view class="field"><text class="field-label">票据用途</text><view class="field-tail"><text class="field-value">{{kinds[kindIndex].name}}</text><text class="chevron">›</text></view></view></picker>
<picker range="{{policies}}" range-key="name" value="{{policyIndex}}" data-key="inclusion_policy" data-list="policies" bindchange="pick" disabled="{{busy}}"><view class="field"><text class="field-label">计入口径</text><view class="field-tail"><text class="field-value">{{policies[policyIndex].name}}</text><text class="chevron">›</text></view></view></picker>
<view class="hint">产品线代码：{{productCode || '未选择'}}</view></view>
 <view class="card"><view class="section-head"><view class="section-title"><text class="section-number">04</text>客户信息</view><button class="compact secondary" wx:if="{{customer_creation_enabled}}" bindtap="openCustomer" disabled="{{busy}}">＋ 新增</button></view>
<picker range="{{customers}}" range-key="display_name" value="{{customer_idIndex}}" data-key="customer_id" data-list="customers" bindchange="pick" disabled="{{busy}}"><view class="field"><text class="field-label">关联客户</text><view class="field-tail"><text class="field-value">{{customers[customer_idIndex].display_name}}</text><text class="chevron">›</text></view></view></picker><picker range="{{levels}}" range-key="name" value="{{customer_levelIndex}}" data-key="customer_level" data-list="levels" bindchange="pick" disabled="{{busy || invoice.customer_id}}"><view class="field"><text class="field-label">客户等级</text><view class="field-tail"><text class="field-value">{{levels[customer_levelIndex].name}}</text><text class="chevron">›</text></view></view></picker>
 <view class="hint" wx:if="{{invoice.customer_id}}">等级来自客户资料，可在网站客户资料中修改。</view>
 <view wx:if="{{newCustomer}}" class="note-panel"><view class="section-title">新增客户</view><view class="edit-field"><text class="input-label">客户名称 · 必填</text><input value="{{newCustomer.name}}" data-key="name" bindinput="customerInput" maxlength="255" placeholder="填写客户全称"/></view><view class="edit-field"><text class="input-label">客户简称</text><input value="{{newCustomer.short_name}}" data-key="short_name" bindinput="customerInput" maxlength="120" placeholder="填写常用简称"/></view><picker range="{{levels}}" range-key="name" value="{{newGradeIndex}}" bindchange="customerGrade"><view class="field"><text class="field-label">客户等级</text><text>{{levels[newGradeIndex].name}} ›</text></view></picker><button class="primary" bindtap="createCustomer" disabled="{{busy}}">保存并选中客户</button><button class="ghost" bindtap="cancelCustomer" disabled="{{busy}}">取消</button></view></view>
 <view wx:if="{{linkedKind}}" class="card"><view class="section-title">{{linkedKind==='entertainment'?'应酬费明细':'出差明细'}}</view><view class="linked-customer"><text class="field-label">关联客户</text><text>{{invoice.linked_detail.customer || '未关联客户'}}</text></view>
 <view wx:for="{{linkedFields}}" wx:key="key" class="edit-field"><text class="input-label">{{item.name}}</text><picker wx:if="{{item.type==='date'}}" mode="date" value="{{invoice.linked_detail[item.key]}}" data-key="{{item.key}}" bindchange="linkedInput" disabled="{{busy}}"><view class="input-value"><text>{{invoice.linked_detail[item.key] || '请选择日期'}}</text><text class="chevron">›</text></view></picker><input wx:else type="{{item.type}}" value="{{invoice.linked_detail[item.key]}}" data-key="{{item.key}}" bindinput="linkedInput" disabled="{{busy}}" maxlength="4000"/></view></view>
 <view class="card"><view class="section-title">月份与打印</view><view class="form-grid">
<view class="edit-field"><text class="input-label">发生月</text><picker mode="date" fields="month" value="{{invoice.occurrence_month}}" data-key="occurrence_month" bindchange="input" disabled="{{busy}}"><view class="input-value"><text>{{invoice.occurrence_month || '未填写'}}</text><text class="chevron">›</text></view></picker><button class="ghost compact" data-key="occurrence_month" bindtap="clearMonth" disabled="{{busy}}">清空</button></view><view class="edit-field"><text class="input-label">结算月 · 可选</text><picker mode="date" fields="month" value="{{invoice.settlement_month}}" data-key="settlement_month" bindchange="input" disabled="{{busy}}"><view class="input-value"><text>{{invoice.settlement_month || '未填写'}}</text><text class="chevron">›</text></view></picker><button class="ghost compact" data-key="settlement_month" bindtap="clearMonth" disabled="{{busy}}">清空</button></view></view><view class="field"><text class="field-label">选中打印</text><switch color="#176b50" checked="{{invoice.print_selected}}" data-key="print_selected" bindchange="toggle" disabled="{{busy}}"/></view></view>
 <view class="card confirmation-card"><view class="confirm-row"><view class="confirm-copy"><view class="confirm-title">我已核对原件与录入信息</view><view class="hint">确认后同步网站，按所选口径计入费用。</view></view><switch color="#176b50" checked="{{confirmed}}" bindchange="agree" disabled="{{busy}}"/></view><button class="primary" bindtap="save" disabled="{{busy || !confirmed}}" loading="{{busy}}">确认并录入网站</button></view>
 </block>
</view>
