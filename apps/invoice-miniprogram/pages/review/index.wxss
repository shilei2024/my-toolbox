.page {
  padding: 24rpx;
  background: #f5f8f6;
  min-height: 100vh;
}
.card {
  background: white;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.section-title {
  font-size: 36rpx;
  font-weight: 600;
}
.muted,
.hint {
  color: #637c72;
  font-size: 26rpx;
  line-height: 1.7;
}
.message {
  background: #fff3d8;
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  line-height: 1.7;
}
.field,
.edit-field {
  padding: 22rpx 0;
  border-bottom: 1px solid #e7efea;
  line-height: 1.6;
}
.edit-field text {
  color: #637c72;
}
.edit-field input {
  background: #f4f7f5;
  padding: 16rpx;
  margin-top: 10rpx;
  border-radius: 12rpx;
  min-height: 48rpx;
}
.primary {
  background: #158662;
  color: white;
  margin-top: 24rpx;
}
button {
  margin-top: 16rpx;
}
