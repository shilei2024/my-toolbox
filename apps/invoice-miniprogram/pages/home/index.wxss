page{background:#f5f8f6;color:#163b30;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}.page{padding:48rpx 32rpx 60rpx}.hero{display:flex;align-items:center;gap:26rpx;margin:18rpx 0 44rpx}.logo{width:112rpx;height:112rpx;border-radius:30rpx;flex-shrink:0}.eyebrow{font-size:21rpx;color:#698577;letter-spacing:2rpx}.title{font-size:48rpx;font-weight:700;margin:6rpx 0}.subtitle{font-size:25rpx;color:#6e877c}.card{padding:32rpx;background:#fff;border:1rpx solid #e2eae5;border-radius:28rpx;margin-bottom:28rpx;box-shadow:0 10rpx 40rpx rgba(27,70,51,.025)}.section-title{font-size:32rpx;font-weight:600;margin-bottom:24rpx}.muted{color:#75867d;font-size:26rpx;line-height:1.7}.small{font-size:23rpx}.primary,.secondary{font-size:28rpx;border-radius:18rpx;line-height:2.9;font-weight:500}.primary{background:#188563;color:#fff;margin-top:28rpx}.secondary{background:#edf5f0;color:#28775a;margin-top:20rpx}button::after{border:0}button[disabled]{opacity:.5}.input{background:#f5f8f6;border:1rpx solid #e2eae5;border-radius:16rpx;padding:20rpx;margin-top:28rpx;height:44rpx;font-size:26rpx}.field{display:flex;justify-content:space-between;align-items:center;font-size:27rpx;padding:24rpx 0;border-bottom:1rpx solid #edf1ed}.hint{font-size:23rpx;color:#7a8a80;line-height:1.7;margin-top:24rpx}.upload-actions{display:flex;gap:16rpx}.upload-actions button{flex:1;padding:0 8rpx;margin-top:28rpx;font-size:25rpx}.account{display:flex;justify-content:space-between;font-size:24rpx;color:#7b8d82;margin:0 6rpx 24rpx}.link,.refresh{color:#188563}.refresh{float:right;font-size:25rpx;font-weight:400}.receipt{padding:24rpx 0;border-bottom:1rpx solid #edf1ed}.receipt:last-child{border-bottom:0}.file-name{font-size:27rpx;word-break:break-all;margin-bottom:8rpx}.tag{display:inline-block;font-size:22rpx;color:#44886a;background:#eff6f0;padding:6rpx 16rpx;border-radius:10rpx;margin-top:10rpx}.upload-state{font-size:23rpx;color:#839287;margin:12rpx 0}.upload-state.success{color:#188563}.upload-state.failed{color:#b35c43}.message{padding:22rpx 26rpx;background:#f9f0dd;color:#8a6a32;border-radius:18rpx;font-size:25rpx;line-height:1.7;margin-bottom:26rpx}.empty{padding:40rpx 0;color:#89968b;text-align:center;font-size:25rpx}.footer{text-align:center;color:#94a297;font-size:23rpx;padding:14rpx 0}

.privacy-mask{position:fixed;inset:0;z-index:99;background:rgba(12,36,25,.4);display:flex;align-items:center;justify-content:center;padding:48rpx}.privacy-card{padding:36rpx;border-radius:28rpx;background:#fff;width:100%;box-sizing:border-box}.privacy-link{font-size:26rpx;margin:24rpx 0}
