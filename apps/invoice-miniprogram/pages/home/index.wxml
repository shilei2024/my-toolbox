<view class="page">
  <view wx:if="{{showPrivacy}}" class="privacy-mask"><view class="privacy-card"><view class="section-title">票据与隐私</view><view class="muted">选择的票据原件会上传并保存到你绑定的网站账号，用于留存、核对和打印。请确认票据属于你，或已获得上传授权。</view><view class="link privacy-link" bindtap="showPrivacy">查看完整隐私保护指引</view><button id="invoice-privacy-agree" class="primary" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="agreePrivacy">同意并继续</button><button class="secondary" bindtap="declinePrivacy">暂不使用</button></view></view>
  <view class="hero"><view class="hero-copy"><view class="eyebrow">CAPTURE & ORGANIZE</view><view class="title">发票录入</view><view class="subtitle">随手收好，让报销更从容。</view></view><image class="logo" src="/assets/logo-v1.png" mode="aspectFill"/></view>
  <view wx:if="{{message}}" class="message" role="status">{{message}}</view>
  <view wx:if="{{!loggedIn}}" class="card"><view class="muted">请先到“我的”登录并绑定网站账号。</view><button class="primary" bindtap="goMine">去我的登录</button></view>
  <block wx:else>
    <view class="card">
      <view class="section-head"><view class="section-title">本次录入</view><text class="step-label">01 / 选择归属</text></view><view class="period-chip">{{periods[periodIndex].name || '请在首页选择报销周期'}}</view>
      <picker range="{{offices}}" range-key="name" value="{{officeIndex}}" bindchange="onOffice" disabled="{{busy}}"><view class="field"><text class="field-label">办事处</text><view class="field-tail"><text class="field-value">{{offices[officeIndex].name || '请选择'}}</text><text class="chevron">›</text></view></view></picker>
      <picker range="{{kinds}}" range-key="label" value="{{kindIndex}}" bindchange="onKind" disabled="{{busy}}"><view class="field"><text class="field-label">票据用途</text><view class="field-tail"><text class="field-value">{{kinds[kindIndex].label}}</text><text class="chevron">›</text></view></view></picker>
      <picker mode="date" fields="month" value="{{month}}" bindchange="onMonth" disabled="{{busy}}"><view class="field"><text class="field-label">实际发生月</text><view class="field-tail"><text class="field-value">{{month}}</text><text class="chevron">›</text></view></view></picker>
      <picker range="{{customers}}" range-key="display_name" value="{{customerIndex}}" bindchange="onCustomer" disabled="{{busy}}"><view class="field"><text class="field-label">关联客户</text><view class="field-tail"><text class="field-value">{{customers[customerIndex].display_name}}</text><text class="chevron">›</text></view></view></picker>
      <picker range="{{levels}}" range-key="name" value="{{levelIndex}}" bindchange="onLevel" disabled="{{busy || customers[customerIndex].id}}"><view class="field"><text class="field-label">客户等级</text><view class="field-tail"><text class="field-value">{{levels[levelIndex].name}}{{customers[customerIndex].id ? '（来自客户资料）' : ''}}</text><text class="chevron">›</text></view></view></picker>
    </view>
    <view class="card upload-card"><view class="section-head"><view class="section-title">收好票据原件</view><text class="step-label">02 / 上传票据</text></view><view class="muted">支持照片与 PDF，上传后继续核对。</view>
      <view class="upload-actions"><button class="primary" bindtap="chooseImage" disabled="{{busy || !periods.length}}">拍照 / 选图片</button><button class="secondary" bindtap="choosePdf" disabled="{{busy || !periods.length}}">微信文件选 PDF</button></view>
      <view class="hint">客户与等级随原件保存，上传后请逐张核对。</view>
      <view class="hint">加油票与过路费仅留存打印；普通发票核对确认后才按所选口径计入费用。</view>
      <view class="hint">发生月与归属周期分开，可跨期留存；账单分摊须对应同自然月派车记录。</view>
    </view>
    <view wx:if="{{queue.length}}" class="card"><view class="section-head"><view class="section-title">本次上传</view><text class="step-label">03 / 核对录入</text></view><view wx:for="{{queue}}" wx:key="key" class="receipt"><view class="file-name">{{item.name}}</view><view class="receipt-meta">{{item.label}}</view><progress wx:if="{{item.state === 'uploading'}}" percent="{{item.progress}}" stroke-width="3" activeColor="#188563"/><view class="upload-state {{item.state}}">{{item.statusText}}</view><button wx:if="{{item.invoiceId}}" size="mini" data-id="{{item.invoiceId}}" bindtap="review">核对并录入</button><button wx:if="{{item.state === 'failed'}}" size="mini" class="secondary" data-index="{{index}}" bindtap="retry" disabled="{{busy}}">重试</button></view></view>
    <view class="card"><view class="section-head"><view class="section-title">本期已收好</view><text class="refresh" bindtap="refresh">刷新</text></view><view wx:if="{{!invoices.length}}" class="empty"><view class="empty-symbol">＋</view>第一张票据，从这里开始。</view><view wx:for="{{invoices}}" wx:key="id" class="receipt" data-id="{{item.id}}" bindtap="review"><view class="file-name">{{item.file_name}}</view><view class="receipt-meta">{{item.kindLabel}} · {{item.occurrence_month}} · {{item.customer || '未关联客户'}} · {{item.customer_level || '未分类'}}</view><view class="tag">{{item.stateLabel}}</view></view><button wx:if="{{hasMore}}" class="secondary" bindtap="more">查看更多</button></view>
  </block>
  <view class="footer" bindtap="showPrivacy">隐私保护指引</view>
</view>
