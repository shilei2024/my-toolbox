<view class="page">
  <view wx:if="{{showPrivacy}}" class="privacy-mask"><view class="privacy-card"><view class="section-title">票据与隐私</view><view class="muted">选择的票据原件会上传并保存到你登录的网站账号，用于留存、核对和打印。请确认票据属于你，或已获得上传授权。</view><view class="link privacy-link" bindtap="showPrivacy">查看完整隐私保护指引</view><button id="invoice-privacy-agree" class="primary" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="agreePrivacy">同意并继续</button><button class="secondary" bindtap="declinePrivacy">暂不使用</button></view></view>
  <view class="hero"><view class="hero-copy"><view class="title">发票</view></view><image class="logo" src="/assets/logo-v3.png" mode="aspectFill"/></view>
  <view wx:if="{{authReady && message}}" class="message" role="status">{{message}}</view>
  <view wx:if="{{authReady && !loggedIn}}" class="card"><view class="muted">登录后上传和管理发票。</view><button class="primary" bindtap="goMine">登录</button></view>
  <block wx:if="{{authReady && loggedIn}}">
    <button wx:if="{{periodIndex < 0}}" class="secondary" bindtap="goDashboard">回首页选择报销周期</button>
    <view class="card upload-card"><view class="section-head"><view class="section-title">上传发票</view></view><view class="muted">支持照片与 PDF，上传后继续核对。</view>
      <view class="upload-actions"><button class="primary" bindtap="chooseImage" disabled="{{busy || periodIndex < 0}}">拍照 / 相册</button><button class="secondary" bindtap="choosePdf" disabled="{{busy || periodIndex < 0}}">选择 PDF</button></view>
      <button class="disclosure" bindtap="toggleHelp" aria-expanded="{{showHelp}}">票据计费规则 <text>{{showHelp ? '收起' : '展开'}}</text></button>
      <view wx:if="{{showHelp}}" class="note-panel">普通发票核对后按所选口径计费；加油票、零散过路费仅留存打印。发生月可跨周期，通行账单须对应同月派车记录。</view>
    </view>
    <view wx:if="{{queue.length}}" class="card"><view class="section-head"><view class="section-title">本次上传</view></view><view wx:for="{{queue}}" wx:key="key" class="receipt"><view class="file-name">{{item.name}}</view><view class="receipt-meta">{{item.label}}</view><progress wx:if="{{item.state === 'uploading'}}" percent="{{item.progress}}" stroke-width="3" activeColor="#514054"/><view class="upload-state {{item.state}}">{{item.statusText}}</view><button wx:if="{{item.invoiceId}}" size="mini" data-id="{{item.invoiceId}}" bindtap="review">核对</button><button wx:if="{{item.state === 'failed'}}" size="mini" class="secondary" data-index="{{index}}" bindtap="retry" disabled="{{busy}}">重试</button></view></view>
    <view class="card"><view class="section-head"><view class="section-title">本期发票</view><text class="refresh" bindtap="refresh">刷新</text></view><view wx:if="{{!invoices.length}}" class="empty"><view class="empty-symbol">＋</view>暂无发票</view><view wx:for="{{invoices}}" wx:key="id" class="receipt" data-id="{{item.id}}" bindtap="review"><view class="file-name">{{item.file_name}}</view><view class="receipt-meta">{{item.kindLabel}} · {{item.occurrence_month}} · {{item.customer || '未关联客户'}} · {{item.customer_level || '未分类'}}</view><view class="tag">{{item.stateLabel}}</view></view><button wx:if="{{hasMore}}" class="secondary" bindtap="more">查看更多</button></view>
  </block>
  <view class="footer" bindtap="showPrivacy">隐私保护指引</view>
</view>
