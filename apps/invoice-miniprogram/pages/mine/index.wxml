<view class="page"><view wx:if="{{showPrivacy}}" class="privacy-mask"><view class="privacy-card"><view class="section-title">票据与隐私</view><view class="muted">票据保存在你的账号，用于核对、录入和打印。</view><view class="link privacy-link" bindtap="showPrivacy">查看完整隐私指引</view><button id="mine-privacy-agree" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="agreePrivacy" class="primary">同意并继续</button><button class="secondary" bindtap="declinePrivacy">暂不使用</button></view></view>
<view class="hero"><view class="hero-copy"><view class="title">我的</view></view><image src="/assets/logo-v3.png" class="logo" mode="aspectFill"/></view><view wx:if="{{authReady && message}}" class="message">{{message}}</view>
<view wx:if="{{authReady && !loggedIn}}" class="card"><view class="account-emblem">↗</view><view class="section-title">账号登录</view><view class="muted">微信首次登录即可使用发票助手。已有网站账号可扫码连接。</view><button class="primary" bindtap="signIn" disabled="{{busy}}">微信注册 / 登录</button><button class="secondary" bindtap="scanBinding" disabled="{{busy}}">连接已有网站账号</button><view class="login-divider"><text>或使用网站账号密码</text></view><input class="input" type="text" value="{{email}}" data-key="email" bindinput="credentialInput" maxlength="255" placeholder="网站账号（邮箱）" disabled="{{busy}}"/><input class="input" password="true" value="{{password}}" data-key="password" bindinput="credentialInput" maxlength="256" placeholder="网站登录密码" disabled="{{busy}}"/><button class="primary" bindtap="signInPassword" loading="{{busy}}" disabled="{{busy}}">登录</button><button class="disclosure" bindtap="toggleLoginOptions" aria-expanded="{{showLoginOptions}}">微信 / 绑定码登录 <text>{{showLoginOptions ? '收起' : '展开'}}</text></button><view wx:if="{{showLoginOptions}}"><button class="secondary" bindtap="scanBinding" disabled="{{busy}}">扫码绑定</button><input class="input" value="{{bindingCode}}" bindinput="onBindingInput" maxlength="64" placeholder="也可粘贴一次性绑定码"/><button class="secondary" bindtap="signIn" loading="{{busy}}" disabled="{{busy}}">{{bindingCode?'绑定并登录':'微信登录'}}</button></view></view>
<view wx:if="{{authReady && loggedIn}}" class="card"><view class="account-emblem">✓</view><view class="account-status"><text class="status-dot"></text>已登录</view><view class="section-title">{{displayName || '我的账号'}}</view><view class="muted">票据在网站与小程序同步。账号安全设置请访问 mindfulpenpal.com。</view><button wx:if="{{!hasPassword}}" class="secondary" bindtap="toggleAccountSetup">设置网站登录</button><view wx:if="{{showAccountSetup}}"><input class="input" value="{{email}}" data-key="email" bindinput="credentialInput" placeholder="邮箱" maxlength="255"/><input class="input" password="true" value="{{password}}" data-key="password" bindinput="credentialInput" placeholder="密码（8位以上，含字母和数字）" maxlength="128"/><button class="primary" bindtap="setupAccount" disabled="{{busy}}">保存登录方式</button></view><button class="ghost" bindtap="logout" disabled="{{busy}}">退出登录</button></view><view class="footer" bindtap="showPrivacy">隐私保护指引</view></view>
