<view class="page"><view wx:if="{{showPrivacy}}" class="privacy-mask"><view class="privacy-card"><view class="section-title">票据与隐私</view><view class="muted">票据保存在你绑定的网站账号，用于核对、录入和打印。</view><view class="link privacy-link" bindtap="showPrivacy">查看完整隐私指引</view><button id="mine-privacy-agree" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="agreePrivacy" class="primary">同意并继续</button><button class="secondary" bindtap="declinePrivacy">暂不使用</button></view></view>
<view class="hero"><image src="/assets/logo-v1.png" class="logo"/><view><view class="title">我的账号</view><view class="subtitle">与网站共用身份和资料</view></view></view><view wx:if="{{message}}" class="message">{{message}}</view>
<view wx:if="{{!loggedIn}}" class="card"><view class="section-title">连接网站账号</view><view class="muted">首次使用，请登录网站「个人资料」生成绑定二维码，再在这里扫码。</view><button class="primary" bindtap="scanBinding" disabled="{{busy}}">扫码绑定</button><input class="input" value="{{bindingCode}}" bindinput="onBindingInput" maxlength="64" placeholder="也可粘贴一次性绑定码"/><button class="secondary" bindtap="signIn" loading="{{busy}}" disabled="{{busy}}">{{bindingCode?'绑定并登录':'微信登录'}}</button></view>
<view wx:else class="card"><view class="section-title">{{displayName || '已登录网站账号'}}</view><view class="muted">当前微信已连接网站账号。解除绑定请在网站个人资料中操作。</view><button class="secondary" bindtap="logout" disabled="{{busy}}">退出登录</button></view><view class="footer" bindtap="showPrivacy">隐私保护指引</view></view>
