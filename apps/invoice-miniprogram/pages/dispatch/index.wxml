<view class="page"><view class="hero"><view class="hero-copy"><view class="eyebrow">TRAVEL LOG</view><view class="title">一路有记录</view><view class="subtitle">派车单 · {{periodName || '请在首页选择周期'}}</view></view></view><view class="message" wx:if="{{message}}">{{message}}</view>
<button wx:if="{{!loggedIn}}" class="primary" bindtap="goMine">去我的登录</button>
<block wx:if="{{loggedIn && periodId}}"><view class="card summary-card" wx:if="{{totals}}"><view class="summary-label">本期实际行驶</view><view class="summary-value">{{totals.km_total}}<text class="distance-unit"> km</text></view><view class="summary-bottom"><view class="summary-stat"><view class="summary-label">过桥费 · 元</view><view class="summary-stat-value">{{totals.toll_fee}}</view></view><view class="summary-stat"><view class="summary-label">停车费 · 元</view><view class="summary-stat-value">{{totals.parking_fee}}</view></view></view><view class="hint">保存后按网站规则计算起止公里与费用；未保存修改不计入仪表盘。</view></view>
<view wx:if="{{editing}}" class="card"><view class="section-title">{{editIndex<0?'新增派车记录':'编辑派车记录'}}</view><picker mode="date" value="{{draft.date}}" data-key="date" bindchange="input"><view class="field"><text class="field-label">日期</text><view class="field-tail"><text class="field-value">{{draft.date}}</text><text class="chevron">›</text></view></view></picker>
<view wx:for="{{textFields}}" wx:key="key" class="edit-field"><view class="input-label">{{item.name}}</view><input class="input" value="{{draft[item.key]}}" data-key="{{item.key}}" bindinput="input" maxlength="255"/></view>
<view wx:for="{{numberFields}}" wx:key="key" class="edit-field"><view class="input-label">{{item.name}}</view><input class="input" type="digit" value="{{draft[item.key]}}" data-key="{{item.key}}" bindinput="input" disabled="{{item.key==='km_start' && editIndex>0}}"/></view>
<picker range="{{lines}}" range-key="name" value="{{lineIndex}}" bindchange="line"><view class="field"><text class="field-label">产品线</text><view class="field-tail"><text class="field-value">{{lines[lineIndex].name}}</text><text class="chevron">›</text></view></view></picker><button class="primary" bindtap="keep">加入待保存列表</button><button class="secondary" bindtap="cancel">取消编辑</button></view>
<block wx:if="{{!editing}}"><button class="primary add-trip" bindtap="add" disabled="{{busy}}">＋ 新增派车记录</button><view wx:if="{{!rows.length}}" class="card empty"><view class="empty-symbol">↗</view>还没有出行记录<view class="hint">记录路程与费用，月底整理更轻松。</view></view><view class="card" wx:for="{{rows}}" wx:key="index"><view class="trip-date">{{item.date}}<text class="trip-product">{{item.product_line || '未分类'}}</text></view><view class="trip-route">{{item.from_location || '未填出发地'}} → {{item.to_location || '未填目的地'}}</view><view class="muted">联系人：{{item.contact}}　公里：{{item.km_total}}</view><view class="muted">起：{{item.km_start}}　止：{{item.km_end}}（自动）</view><view class="muted">过桥费：{{item.toll_fee || 0}}　停车费：{{item.parking_fee || 0}}</view><view wx:if="{{item.allocated}}" class="tag">已关联通行账单分摊</view><view class="button-row"><button class="secondary" data-index="{{index}}" bindtap="edit" size="mini" disabled="{{busy || item.allocated}}">编辑</button><button class="danger" data-index="{{index}}" bindtap="remove" size="mini" disabled="{{busy || item.allocated}}">删除</button></view></view>
<button class="primary" bindtap="save" disabled="{{busy || !dirty}}" loading="{{busy}}">保存派车单并同步网站</button><button class="secondary" bindtap="reload" disabled="{{busy}}">刷新网站记录</button></block></block></view>
