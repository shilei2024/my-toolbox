<view class="page"><view class="title">派车单</view><view class="subtitle">当前周期：{{periodName || '请在首页选择'}}</view><view class="message" wx:if="{{message}}">{{message}}</view>
<button wx:if="{{!loggedIn}}" class="primary" bindtap="goMine">去我的登录</button>
<block wx:if="{{loggedIn && periodId}}"><view class="card" wx:if="{{totals}}"><view>公里：{{totals.km_total}}　过桥费：{{totals.toll_fee}}　停车费：{{totals.parking_fee}}</view><view class="hint">保存后按网站规则计算起止公里与费用；未保存修改不计入仪表盘。</view></view>
<view wx:if="{{editing}}" class="card"><view class="section-title">{{editIndex<0?'新增派车记录':'编辑派车记录'}}</view><picker mode="date" value="{{draft.date}}" data-key="date" bindchange="input"><view class="field">日期：{{draft.date}} ›</view></picker>
<view wx:for="{{textFields}}" wx:key="key"><view class="muted">{{item.name}}</view><input class="input" value="{{draft[item.key]}}" data-key="{{item.key}}" bindinput="input" maxlength="255"/></view>
<view wx:for="{{numberFields}}" wx:key="key"><view class="muted">{{item.name}}</view><input class="input" type="digit" value="{{draft[item.key]}}" data-key="{{item.key}}" bindinput="input" disabled="{{item.key==='km_start' && editIndex>0}}"/></view>
<picker range="{{lines}}" range-key="name" value="{{lineIndex}}" bindchange="line"><view class="field">产品线：{{lines[lineIndex].name}} ›</view></picker><button class="primary" bindtap="keep">加入待保存列表</button><button class="secondary" bindtap="cancel">取消编辑</button></view>
<block wx:if="{{!editing}}"><button class="primary" bindtap="add" disabled="{{busy}}">新增派车记录</button><view class="card" wx:for="{{rows}}" wx:key="index"><view class="section-title">{{item.date}} · {{item.product_line || '未分类'}}</view><view>{{item.from_location || '未填出发地'}} → {{item.to_location || '未填目的地'}}</view><view class="muted">联系人：{{item.contact}}　公里：{{item.km_total}}</view><view class="muted">起：{{item.km_start}}　止：{{item.km_end}}（自动）</view><view class="muted">过桥费：{{item.toll_fee || 0}}　停车费：{{item.parking_fee || 0}}</view><view wx:if="{{item.allocated}}" class="tag">已关联通行账单分摊</view><button data-index="{{index}}" bindtap="edit" size="mini" disabled="{{busy || item.allocated}}">编辑</button><button data-index="{{index}}" bindtap="remove" size="mini" disabled="{{busy || item.allocated}}">删除</button></view>
<button class="primary" bindtap="save" disabled="{{busy || !dirty}}" loading="{{busy}}">保存派车单并同步网站</button><button class="secondary" bindtap="reload" disabled="{{busy}}">刷新网站记录</button></block></block></view>
